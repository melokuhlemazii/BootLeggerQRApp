@model BootLeggerQRApp.Models.Order

@{
    ViewData["Title"] = "Payment";
}

<div class="row gy-4">
    <div class="col-lg-7">
        <div class="centered-form">
            <h2 class="mb-3">Order Summary</h2>

            <div class="order-summary">
                <ul>
                    @foreach (var item in Model.OrderItems)
                    {
                        <li>
                            <div>
                                <div class="fw-semibold">@item.MenuItem.Name</div>
                                <div class="text-muted small">@item.MenuItem.Description</div>
                            </div>
                            <div class="text-end">
                                <div>@item.Quantity x @item.MenuItem.Price.ToString("C")</div>
                                <div class="fw-bold">@(item.Quantity * item.MenuItem.Price).ToString("C")</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="text-muted">Subtotal</div>
                <div class="fw-bold">@ViewBag.Subtotal.ToString("C")</div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="text-muted">Total</div>
                <div class="fw-bold fs-5">@ViewBag.GrandTotal.ToString("C")</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="centered-form">
            <h2 class="mb-3">Payment</h2>

            <form asp-action="Confirm" method="post">
                <input type="hidden" name="orderId" value="@Model.OrderId" />

                <div class="mb-3">
                    <label class="form-label">Select Payment Method</label>
                    <div class="payment-options">
                        <label class="payment-card">
                            <input type="radio" name="paymentMethod" value="Cash" checked style="display:none;" />
                            <div class="title">Cash on Delivery</div>
                            <div class="muted">Pay in cash when your order arrives.</div>
                        </label>

                        <label class="payment-card">
                            <input type="radio" name="paymentMethod" value="Card" style="display:none;" />
                            <div class="title">Card Payment</div>
                            <div class="muted">Pay now with card (mock gateway).</div>
                        </label>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Confirm & Pay</button>
                    <a asp-controller="Orders" asp-action="MyOrder" class="btn btn-outline-secondary">Back to Order</a>
                </div>
            </form>
        </div>
    </div>
</div>



