@model BootLeggerQRApp.Models.Order

@{
    ViewData["Title"] = "Payment Confirmation";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="confirmation-box text-center">
            <h2>Payment Confirmed</h2>
            <p class="text-muted">Thank you — your payment has been registered.</p>

            <div class="mt-3">
                <strong>Payment Method:</strong> @ViewBag.PaymentMethod
            </div>

            <div class="mt-3 mb-4">
                <div class="order-summary">
                    <ul>
                        @foreach (var item in Model.OrderItems)
                        {
                            <li>
                                <div>@item.MenuItem.Name</div>
                                <div class="fw-semibold">@(item.Quantity * item.MenuItem.Price).ToString("C")</div>
                            </li>
                        }
                    </ul>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <div class="text-muted">Total to Pay</div>
                    <div class="fw-bold">@ViewBag.GrandTotal.ToString("C")</div>
                </div>
            </div>

            @if (ViewBag.PaymentMethod == "Cash")
            {
                <div class="alert alert-info mt-3">Please wait at your table. A waiter will bring your order and you will pay in cash upon delivery.</div>
            }
            else
            {
                <div class="alert alert-success mt-3">Card payment option selected. (Integration with gateway can be added later.)</div>
            }

            <div class="mt-4">
                <a asp-controller="QRCode" asp-action="Menu" class="btn btn-green me-2">Browse More</a>
                <a asp-controller="Orders" asp-action="MyOrder" class="btn btn-outline-secondary">View Order</a>
            </div>

            <div class="mt-3 text-muted">Status: <strong>@Model.Status</strong></div>
        </div>
    </div>
</div>

