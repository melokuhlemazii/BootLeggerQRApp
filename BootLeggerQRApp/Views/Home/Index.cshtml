@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="landing-page">
    <div class="overlay">
        <div class="container">
            <div class="welcome-text">
                <h1>Welcome to Bootlegger</h1>
                <p>Scan the QR code on your table to browse the menu and order. Enjoy great food and drinks without waiting in line.</p>
                <a class="btn btn-lg btn-primary" asp-controller="QRCode" asp-action="Index" role="button">Browse Menu</a>
            </div>
        </div>
    </div>
</div>






